theme
{
    name="modern"
    dark=auto
    view=view.medium
    background
    {
        color=#0808d2
        opacity=100
        effect=2
        gradient
        {
            enabled=true
            linear=[0, 100, 0, 0]
            stop=[
                [0, #2a0505],
                [0.33, #b3182a],
                [0.66, #3a2a6b],
                [1, #0a0a2e]
            ]
        }
    }
    item
    {
        radius=1
        text
        {
            normal=#ffffff
            select=#ffffff
        }
    }
    image
    {
        color=[#cccccc, #aaaaaa, #888888]
        align=2
    }
    shadow
    {
        enabled=true
        size=8
        color=#000000
        opacity=40
        offset=2
    }
}
